# Conexão com o Postgres. No Railway use a referência ${{Postgres.DATABASE_URL}};
# aqui na máquina, cole a URL PÚBLICA do banco (Railway → Postgres → Connect → Public Network).
DATABASE_URL=postgresql://usuario:senha@host:porta/railway

# Primeiro acesso: se o banco ainda não tiver nenhum usuário, o servidor cria este.
# Depois de entrar, troque a senha e pode apagar estas três variáveis.
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD=uma-senha-boa-de-no-minimo-8-caracteres
ADMIN_NAME=João Flório
